{
  "name": "101codecrafts-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API-first backend for the 101 Codecrafts members site (Next.js route handlers on Vercel + Supabase + Clerk + Flutterwave + Resend).",
  "scripts": {
    "prebuild": "node scripts/copy-static.mjs",
    "dev": "node scripts/copy-static.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:db": "node ../supabase/tests/run.mjs",
    "gen:types": "node scripts/gen-types.mjs > types/database.ts",
    "test:ai": "vitest run --config lib/ai/vitest.config.ts",
    "test:ai:live": "LIVE_GATEWAY=1 vitest run --config lib/ai/vitest.config.ts live-gateway"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.132",
    "@ai-sdk/openai-compatible": "^3.0.82",
    "@ai-sdk/provider": "^4.0.35",
    "@ai-sdk/react": "^4.0.163",
    "@clerk/nextjs": "^6.39.8",
    "@excalidraw/excalidraw": "^0.18.1",
    "@supabase/supabase-js": "^2.118.0",
    "ai": "^7.0.159",
    "next": "^15.5.28",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "svix": "^1.99.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@electric-sql/pglite-pgvector": "^0.0.15",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
