{
  "name": "101codecrafts-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API-first backend for the 101 Codecrafts members site (Next.js route handlers on Vercel + Supabase + Clerk + Flutterwave + Resend).",
  "scripts": {
    "prebuild": "node scripts/copy-static.mjs",
    "dev": "node scripts/copy-static.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:db": "node ../supabase/tests/run.mjs",
    "gen:types": "node scripts/gen-types.mjs > types/database.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.8",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^15.5.28",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "svix": "^1.99.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
