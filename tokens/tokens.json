{
  "$description": "101 Codecrafts design tokens. Source of truth for web (css/tokens.css, generated by tools/tokens.py) and future Android/iOS/Windows/macOS apps. Colours sampled from the two mockups.",
  "color": {
    "orange": "#fc8c0c",
    "orange-landing": "#fd9104",
    "cyan": "#05e6f2",
    "cyan-landing": "#00d5f9",
    "ink": "#0B1236",
    "ink-2": "#0B1236",
    "navy": "#0B1236",
    "navy-2": "#111A45",
    "navy-3": "#111A45",
    "page": "#f7f8f8",
    "page-landing": "#f3f6f7",
    "surface": "#f7f8f9",
    "surface-2": "#ebeced",
    "line": "#e0e6ea",
    "line-dark": "#26306A",
    "muted": "#3e5d74",
    "link": "#146c9f",
    "white": "#ffffff",
    "success": "#0f7a45",
    "danger": "#d93636",
    "warning": "#fc8c0c",
    "focus": "#00b9e6",
    "orange-text": "#a85400",
    "orange-text-large": "#c96f00",
    "cyan-text": "#007a99"
  },
  "font": {
    "display": "\"Archivo Black\", \"Russo One\", Impact, sans-serif",
    "display-2": "\"Russo One\", Impact, sans-serif",
    "body": "\"Body\", \"Barlow\", system-ui, sans-serif",
    "cond": "\"Cond\", \"Saira Semi Condensed\", system-ui, sans-serif"
  },
  "size": {
    "xs": "10px",
    "sm": "12px",
    "md": "14px",
    "lg": "18px",
    "xl": "24px",
    "2xl": "32px",
    "3xl": "48px"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px"
  },
  "radius": {
    "none": "0px",
    "sm": "3px",
    "md": "4px",
    "lg": "6px",
    "pill": "999px"
  },
  "shadow": {
    "brutal": "6px 6px 0 #0B1236",
    "brutal-accent": "6px 6px 0 #fc8c0c",
    "brutal-sm": "3px 3px 0 #0B1236",
    "soft": "0 1px 3px rgba(16,24,31,.06)"
  },
  "border": {
    "brutal": "2px solid #0B1236",
    "thin": "1px solid #e0e6ea"
  },
  "touch": {
    "min-target": "44px"
  },
  "motion": {
    "fast": "160ms",
    "base": "250ms",
    "slow": "600ms",
    "ease": "cubic-bezier(.2,.8,.2,1)"
  },
  "breakpoint": {
    "mobile": "760px",
    "tablet": "1100px"
  },
  "step": {
    "-2": "clamp(0.75rem, 0.7309rem + 0.085vw, 0.8125rem)",
    "-1": "clamp(0.875rem, 0.8559rem + 0.085vw, 0.9375rem)",
    "0": "clamp(1rem, 0.9617rem + 0.1701vw, 1.125rem)",
    "1": "clamp(1.125rem, 1.0485rem + 0.3401vw, 1.375rem)",
    "2": "clamp(1.3125rem, 1.1977rem + 0.5102vw, 1.6875rem)",
    "3": "clamp(1.5625rem, 1.3903rem + 0.7653vw, 2.125rem)",
    "4": "clamp(1.875rem, 1.6263rem + 1.1054vw, 2.6875rem)",
    "5": "clamp(2.25rem, 1.9056rem + 1.5306vw, 3.375rem)",
    "6": "clamp(2.6875rem, 2.2283rem + 2.0408vw, 4.1875rem)"
  },
  "space-fluid": {
    "3xs": "clamp(0.25rem, 0.2309rem + 0.085vw, 0.3125rem)",
    "2xs": "clamp(0.5rem, 0.4809rem + 0.085vw, 0.5625rem)",
    "xs": "clamp(0.75rem, 0.7117rem + 0.1701vw, 0.875rem)",
    "s": "clamp(1rem, 0.9617rem + 0.1701vw, 1.125rem)",
    "m": "clamp(1.5rem, 1.4235rem + 0.3401vw, 1.75rem)",
    "l": "clamp(2rem, 1.8469rem + 0.6803vw, 2.5rem)",
    "xl": "clamp(3rem, 2.7704rem + 1.0204vw, 3.75rem)",
    "2xl": "clamp(4rem, 3.6173rem + 1.7007vw, 5.25rem)"
  },
  "measure": {
    "body": "68ch",
    "narrow": "45ch"
  },
  "$typeScale": {
    "note": "Fluid type scale (Utopia-style): each step interpolates linearly from its min px at a 360px viewport to its max px at 1536px, written as clamp(rem, rem + vw, rem) so browser zoom and user font settings still scale it; every max <= 2.5x min (WCAG 1.4.4).",
    "minViewport": 360,
    "maxViewport": 1536,
    "px": {
      "-2": {
        "min": 12,
        "max": 13
      },
      "-1": {
        "min": 14,
        "max": 15
      },
      "0": {
        "min": 16,
        "max": 18
      },
      "1": {
        "min": 18,
        "max": 22
      },
      "2": {
        "min": 21,
        "max": 27
      },
      "3": {
        "min": 25,
        "max": 34
      },
      "4": {
        "min": 30,
        "max": 43
      },
      "5": {
        "min": 36,
        "max": 54
      },
      "6": {
        "min": 43,
        "max": 67
      }
    }
  }
}