{
  "$comment": "101 Codecrafts shared access contract (owner: r11 auth). Front end reads it via js/access.js (CCAccess.can / .limit / .gate); the backend mirrors it in backend/data/access-policy.json + lib/access.ts and RLS. Action keys are <area>.<verb>. 'roles' = who may; 'plans' (optional) = plans a learner/tutor must hold (staff bypass plans); 'minor' = 'deny' blocks under-18s always, 'consent' blocks them until a guardian has verified. Limits are DEFAULTS only: the server overrides them from admin-edited plan settings (GET /api/v1/auth/session -> limits). null = unlimited/not set.",
  "version": 1,
  "roles": ["visitor", "guest", "learner", "tutor", "admin", "root_admin"],
  "plans": ["free", "standard", "plus", "pro"],
  "staff": ["admin", "root_admin"],
  "root_email": "101codecrafts@gmail.com",
  "home": {
    "visitor": "/index.html",
    "guest": "/guest.html",
    "learner": "/dashboard.html",
    "tutor": "/tutor.html",
    "admin": "/admin.html",
    "root_admin": "/admin.html"
  },
  "auth_route": "/auth.html",
  "pages": {
    "$comment": "page (file name without .html) -> action needed to open it; unlisted pages are public. Denied visitor -> auth_route?next=; denied signed-in user -> their home (never the same page).",
    "dashboard": "dashboard.learner", "tutor": "dashboard.tutor", "admin": "dashboard.admin", "guest": "guest.home",
    "courses": "course.browse", "course": "course.browse", "learn": "course.browse", "article": "course.browse",
    "practice": "practice.use", "problem": "practice.use", "ide": "practice.use", "contests": "practice.use", "contest": "practice.use", "interview": "practice.use",
    "resources": "resource.open", "ai-tools": "ai.chat",
    "marketplace": "market.browse", "product-item": "market.browse", "cart": "market.buy", "checkout": "market.buy", "orders": "market.buy", "rfq": "market.buy", "seller": "market.sell",
    "projects": "shell.full", "launchpad": "shell.full", "testing": "shell.full", "competitions": "shell.full", "sessions": "shell.full", "session": "shell.full",
    "whiteboard": "shell.full", "card": "shell.full", "cards": "shell.full", "groups": "community.post",
    "announcements": "shell.app", "settings-apps": "shell.app", "profile": "shell.app"
  },
  "plans_route": "/settings-apps.html#plan",
  "guardian_route": "/settings-apps.html#guardian",
  "actions": {
    "page.public":          { "roles": ["visitor", "guest", "learner", "tutor", "admin", "root_admin"] },
    "news.read":            { "roles": ["visitor", "guest", "learner", "tutor", "admin", "root_admin"] },
    "event.browse":         { "roles": ["visitor", "guest", "learner", "tutor", "admin", "root_admin"] },

    "shell.app":            { "roles": ["guest", "learner", "tutor", "admin", "root_admin"] },
    "shell.full":           { "roles": ["learner", "tutor", "admin", "root_admin"] },
    "guest.home":           { "roles": ["guest"] },
    "dashboard.learner":    { "roles": ["learner"] },
    "dashboard.tutor":      { "roles": ["tutor"] },
    "dashboard.admin":      { "roles": ["admin", "root_admin"] },
    "demo.view":            { "roles": ["admin", "root_admin"] },

    "course.browse":        { "roles": ["guest", "learner", "tutor", "admin", "root_admin"] },
    "course.take_external": { "roles": ["guest", "learner", "tutor", "admin", "root_admin"] },
    "course.take_free":     { "roles": ["guest", "learner", "tutor", "admin", "root_admin"] },
    "course.take_tutor":    { "roles": ["learner", "tutor", "admin", "root_admin"], "minor": "consent" },
    "course.take_premium":  { "roles": ["learner", "tutor", "admin", "root_admin"], "plans": ["standard", "plus", "pro"], "minor": "consent" },
    "course.create":        { "roles": ["tutor", "admin", "root_admin"] },
    "course.set_price":     { "roles": ["tutor", "admin", "root_admin"] },
    "course.set_free":      { "roles": ["admin", "root_admin"] },
    "course.rate":          { "roles": ["learner", "tutor"], "minor": "consent", "$comment": "server also requires an enrolment or completed use" },

    "resource.open":        { "roles": ["guest", "learner", "tutor", "admin", "root_admin"] },
    "resource.rate":        { "roles": ["learner", "tutor"], "minor": "consent" },
    "practice.use":         { "roles": ["guest", "learner", "tutor", "admin", "root_admin"] },
    "ai.chat":              { "roles": ["guest", "learner", "tutor", "admin", "root_admin"] },

    "market.browse":        { "roles": ["guest", "learner", "tutor", "admin", "root_admin"] },
    "market.buy":           { "roles": ["guest", "learner", "tutor", "admin", "root_admin"], "minor": "consent" },
    "market.sell":          { "roles": ["learner", "tutor"], "minor": "deny" },

    "project.create":       { "roles": ["learner", "tutor"], "minor": "consent" },
    "session.book":         { "roles": ["learner", "tutor"], "minor": "consent" },
    "session.host":         { "roles": ["tutor"] },
    "event.register":       { "roles": ["learner", "tutor", "admin", "root_admin"], "minor": "consent" },
    "community.post":       { "roles": ["learner", "tutor", "admin", "root_admin"], "minor": "consent" },
    "message.send":         { "roles": ["learner", "tutor", "admin", "root_admin"], "minor": "consent" },
    "profile.public":       { "roles": ["learner", "tutor", "admin", "root_admin"], "minor": "deny" },

    "profile.edit":         { "roles": ["guest", "learner", "tutor", "admin", "root_admin"] },
    "account.upgrade":      { "roles": ["guest"] },
    "plan.upgrade":         { "roles": ["learner", "tutor"] },
    "payout.manage":        { "roles": ["tutor"], "minor": "deny" },
    "guardian.manage":      { "roles": ["guest", "learner"] },

    "approvals.review":     { "roles": ["admin", "root_admin"] },
    "users.manage":         { "roles": ["admin", "root_admin"] },
    "plans.edit":           { "roles": ["admin", "root_admin"] },
    "flags.edit":           { "roles": ["admin", "root_admin"] },
    "audit.read":           { "roles": ["admin", "root_admin"] },
    "admin.add":            { "roles": ["root_admin"] },
    "admin.remove":         { "roles": ["root_admin"] }
  },
  "limits": {
    "learner": {
      "free":     { "courses.active": 1, "lessons.preview_only": true, "sessions.per_month": 0 },
      "standard": { "courses.active": null, "lessons.preview_only": false, "sessions.per_month": null },
      "plus":     { "courses.active": null, "lessons.preview_only": false, "sessions.per_month": null },
      "pro":      { "courses.active": null, "lessons.preview_only": false, "sessions.per_month": null }
    },
    "tutor": {
      "free":     { "students.max": 2, "courses.published": null },
      "standard": { "students.max": null, "courses.published": null },
      "plus":     { "students.max": null, "courses.published": null },
      "pro":      { "students.max": null, "courses.published": null }
    }
  }
}
